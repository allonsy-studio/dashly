# .env.example — Template for required environment variables.
# Copy to `.env` and fill in your own values.
# NEVER commit .env to version control.

# --- NPM ---
# Your NPM token (for publishing to npm via semantic-release in CI)
NPM_TOKEN=

# --- GitHub ---
# GitHub personal access token (used by semantic-release for the
# release commit + GitHub Release).
GITHUB_TOKEN=
